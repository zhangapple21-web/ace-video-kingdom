        "maps_to": ["episode_structure", "episode_script"],
        "authority": "candidate_only"
      },
      {
        "role_id": "conflict_emotion_expert",
        "title": "冲突与情绪专家",
        "stage": "script_review",
        "responsibilities": ["双方目标、施压升级、情绪价值和关系变化", "阻止把对话写成信息传递或无意义拉长"],
        "maps_to": ["quality_review", "conflict_driven_scene_engine"],
        "authority": "advisory"
      },
      {
        "role_id": "shot_expert",
        "title": "镜头专家",
        "stage": "shot_plan",
        "responsibilities": ["画面构图、机位、动作、听者反应和视觉语言"],
        "maps_to": ["shot_plan", "production_mapping"],
        "authority": "candidate_only"
      },
      {
        "role_id": "continuity_auditor",
        "title": "连续性审校专家",
        "stage": "audit",
        "responsibilities": ["因果、人物状态、资产绑定、时间线和信息权限"],
        "maps_to": ["quality_review", "production_mapping"],
        "authority": "review_only"
      },
      {
        "role_id": "director_convergence",
        "title": "导演收敛专家",
        "stage": "convergence",
        "responsibilities": ["把已审方案收敛为可拍、可演、可验收的执行稿"],
        "maps_to": ["production_mapping", "quality_review"],
        "authority": "candidate_only"
      }
    ],
    "execution_policy": "职责协议只组织创作判断，不新增调度器、Provider 或生产准入；同一职责由现有席位承接，外部研究必须先留在研究层。"
