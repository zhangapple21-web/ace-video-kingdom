{
  "schema": "video_kingdom.generic_default_layer_checklist.v1",
  "source": "https://github.com/62656456/ai-film-skills",
  "layer": "DEFAULT_METHOD",
  "production_integration": false,
  "note": "方法进入现有字段/检查习惯；不换六模块外壳、不改现役合同、不换入口。缺省不阻断旧合同。",
  "checks": [
    {
      "id": "A01",
      "item": "禁止已定镜头补戏",
      "file": "assets/templates/director_preflight.v1.json",
      "field": "director_preflight.spatial_audit.locked_shot_no_added_beats / forbidden_additions",
      "also": "assets/templates/shot_rhythm_contract.v1.json#default_layer_checks.no_add_beats_after_shot_lock",
      "severity": "advisory",
      "new_drama": "required"
    },
    {
      "id": "A02",
      "item": "世界位置不等于画面左右",
      "file": "assets/templates/director_preflight.v1.json",
      "field": "director_preflight.spatial_audit.world_position / screen_left_right / world_not_equal_screen",
      "also": "assets/templates/continuity_bridge.v1.json#world_position,screen_left_right",
      "severity": "advisory",
      "new_drama": "required"
    },
    {
      "id": "A03",
      "item": "先导演包再编译提示词",
      "file": "assets/templates/director_preflight.v1.json",
      "field": "compile_order.director_packet_before_prompt",
      "also": "governance/director_preflight_contract.v1.json#default_layer_checks",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A04",
      "item": "摄影完整性自检",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.photography + color_temperature_k",
      "also": "tools/validate_shot_rhythm.py 仅在 photography 出现时警告",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A05",
      "item": "切点必须有动机",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "performance_beats.cut_motivation 与 hard_constraints.camera_change_must_be_motivated",
      "also": "director_preflight.performance.edit_intent",
      "severity": "existing_required",
      "new_drama": "advisory"
    },
    {
      "id": "A06",
      "item": "装不下则拆镜或延长，不吞词",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.overflow_policy",
      "also": "hard_constraints.timing_is_audio_or_action_driven",
      "severity": "advisory",
      "new_drama": "required"
    },
    {
      "id": "A07",
      "item": "实体主光换机位后重算",
      "file": "assets/templates/director_preflight.v1.json",
      "field": "director_preflight.lighting.recompute_on_camera_change",
      "also": "continuity_bridge.lighting_state",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A08",
      "item": "受力与接触",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.force_and_contact",
      "also": "director_preflight.performance.force_and_contact；continuity_bridge.force_and_contact",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A09",
      "item": "资产 initial/change/final 进入连续性",
      "file": "assets/templates/continuity_bridge.v1.json",
      "field": "asset_register[].initial/change/final",
      "also": "character/scene/prop state_contract",
      "severity": "advisory",
      "new_drama": "required"
    },
    {
      "id": "A10",
      "item": "人物/场景/道具分册 + locked_features + 变体不覆盖",
      "file": "assets/templates/character_asset_package.v1.json",
      "field": "locked_features / variant_policy",
      "also": "scene_asset_package.v1.json；prop_asset_package.v1.json",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A11",
      "item": "静态资产不写动作或台词",
      "file": "assets/templates/character_asset_package.v1.json",
      "field": "static_asset_rules",
      "also": "scene/prop 同名字段",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A12",
      "item": "材质写结构",
      "file": "assets/templates/character_asset_package.v1.json",
      "field": "material_structure",
      "also": "scene/prop 同名字段",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A13",
      "item": "事实/推定/未知分开",
      "file": "assets/templates/director_preflight.v1.json",
      "field": "knowledge_status",
      "also": "资产包 design_basis",
      "severity": "advisory",
      "new_drama": "required"
    },
    {
      "id": "A14",
      "item": "有依据才写负向，题材硬禁仍写",
      "file": "assets/templates/creative_constraints.v1.json",
      "field": "negative_constraints_policy",
      "also": "shot_prompt_template.negative_constraint_evidence",
      "severity": "advisory",
      "new_drama": "required"
    },
    {
      "id": "A15",
      "item": "段落不等于镜头",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.unit=shot_not_sequence",
      "also": "default_layer_checks.sequence_is_not_a_shot",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A16",
      "item": "资产图默认不当锁死机位；绑定由该剧简报决定",
      "file": "assets/templates/character_asset_package.v1.json",
      "field": "reference_image_camera_lock=false / binding_policy",
      "also": "scene/prop 同名字段",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A17",
      "item": "无理由不运动；填写 camera_motion_level / camera_motion_reason",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.camera_motion_level / camera_motion_reason",
      "also": "tools/validate_shot_rhythm.py 有字段才警告；旧合同缺省不阻断",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A18",
      "item": "对白默认不瞎推机，不等于静帧；提交「镜头：」=一条运动+一句理由；禁止电影感推进",
      "file": "docs/SHOT_RHYTHM_GUIDE.v1.md",
      "field": "运镜等级.submit_lens_line_is_motion_plus_reason",
      "also": "C:/Users/Administrator/.codex/skills/video-kingdom/SKILL.md 运镜方法默认层",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A19",
      "item": "失败先降摄影，不改对白、不改剧情、不换模型",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "default_layer_checks.fail_downgrade_photography_not_plot",
      "also": "COMPLEX 必须有 photography.camera_path/speed/focus_handoff/landing",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A20",
      "item": "禁止无信息垫秒；请求时长=节拍后 STOP",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.underfill_policy / hold_reason",
      "also": "default_layer_checks.no_unmotivated_pad, duration_equals_beats_then_stop；tools/validate_shot_rhythm.py 仅在 requested_seconds 与 audio_duration_seconds 同时出现时 warning",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A21",
      "item": "Provider 时长不是创作时长；生成后剪掉无观看任务的死气",
      "file": "docs/SHOT_RHYTHM_GUIDE.v1.md",
      "field": "观看密度.provider_duration_is_not_creative_duration",
      "also": "C:/Users/Administrator/.codex/skills/video-kingdom/SKILL.md 观看密度默认层；完整性轴 overflow 仍保留",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A22",
      "item": "短剧必须有可看变化；禁止两张参考图互相挪动冒充表演；NONE 固定机位时表演/听者/道具仍要能看",
      "file": "docs/SHOT_RHYTHM_GUIDE.v1.md",
      "field": "运镜等级.none_is_not_freeze_frame",
      "also": "观看密度.watchable_change_not_still_photo",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A23",
      "item": "提交句动作先于镜头；禁止自然微动作；身份锚图是 reference 不是 keyframe 首尾帧",
      "file": "docs/SHOT_RHYTHM_GUIDE.v1.md",
      "field": "submit_sentence.action_before_camera",
      "also": "assets/templates/shot_rhythm_contract.v1.json#optional_fields.media_role / submit_lens_line; tools/validate_shot_rhythm.py warning only",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A24",
      "item": "角色包是长期身份资产（脸/体型/基础服装/角色道具），不是图生视频源。场景默认是 Scene State，不强制预制场景图库。道具默认当镜状态，角色绑定道具除外。本镜 images[] 优先绑角色包，禁止只塞脸裁图。构图未锁时才 gpt-image-2 出静帧并人工审",
      "file": "docs/SHOT_RHYTHM_GUIDE.v1.md",
      "field": "identity_pack.long_term_asset / scene_prep_policy=dynamic_scene_state_not_image_library",
      "also": "shot_rhythm optional_fields.identity_usage / asset_books_binding; character/scene/prop packages; C16",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A25",
      "item": "四层分开：Character Identity / Scene State / Shot State / Approved State。换装湿发哭过走人物集状态，不写回身份包，也不等于场景图",
      "file": "assets/templates/character_asset_package.v1.json",
      "field": "identity_layer / scene_state / shot_state / approved_state",
      "also": "director_preflight.consistency_layers；continuity_bridge.inherit_policy",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A26",
      "item": "下一镜只继承 Approved State；最新未审帧不得当延续参考；错误先修当前镜",
      "file": "assets/templates/continuity_bridge.v1.json",
      "field": "inherit_policy=approved_state_only",
      "also": "SHOT_RHYTHM_GUIDE；C17",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A27",
      "item": "Reference 按需调用（要稳身份时带），不是每镜塞满所有图；First Frame 只承载 Shot State，默认仍是 flash_mode=reference",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.reference_policy / flash_mode_default",
      "also": "C16；C19",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A28",
      "item": "角色包提前准备即可开拍；场景用 Scene State 由剧本+前后镜动态建立。同场要记空间关系/时间光线/家具风格，不要改成每个场景先做一张参考图",
      "file": "assets/templates/scene_asset_package.v1.json",
      "field": "origin=dynamic_scene_state_not_image_library / reference_images_required=false / scene_state",
      "also": "shot_rhythm optional_fields.scene_prep_policy；C20；实拍场地锁仍是项目策略",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A29",
      "item": "降摄影只降 camera_motion_level，不等于把景别塌成证件照或 MCUSTATIC",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.downgrade_motion_not_collapse_scale",
      "also": "docs/SHOT_RHYTHM_GUIDE.v1.md; C21/C22",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A30",
      "item": "对白/电话/双人至少一镜能看见环境；MCU/中近景不是全剧默认拍法",
      "file": "docs/SHOT_RHYTHM_GUIDE.v1.md",
      "field": "shot_sizes + optional_fields.dialogue_environment_visible",
      "also": "assets/templates/shot_rhythm_contract.v1.json#shot_sizes",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A31",
      "item": "身份裁图只锁身份，不得当构图主图或 input_images[0]；场地参考已绑定则景别必须让空间进画",
      "file": "assets/templates/shot_rhythm_contract.v1.json",
      "field": "optional_fields.input_images_role",
      "also": "director_preflight.spatial_audit.environment_visible_when_location_bound; C22",
      "severity": "advisory",
      "new_drama": "advisory"
    },
    {
      "id": "A32",
      "item": "正反打可拆 clip，不可拆成两张角色包对口型；至少一侧过肩或半身",
      "file": "docs/SHOT_RHYTHM_GUIDE.v1.md",
      "field": "reverse_shot_not_two_id_photos",
      "also": "director_preflight.camera.reverse_shot_policy",
      "severity": "advisory",
      "new_drama": "advisory"
    }
  ],
  "new_drama_production_semantics": {
    "file": "governance/new_drama_production_semantics.v1.json",
    "gate_ids": [
      "A01",
      "A02",
      "A06",
      "A09",
      "A13",
      "A14"
    ],
    "applies_when": "production_semantics=new_drama",
    "note": "新剧压缩语义，不是第二套规则。旧合同缺省不走此门。"
  }
}
