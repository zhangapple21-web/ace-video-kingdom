{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video_kingdom.shot_prompt_template.v1",
  "description": "镜头提示词五段式。用户指定结构：风格基准 + 起始空间 + 底声 + 分时序动作 + 余韵。TXT 六要素（主体+动作+环境+光线+镜头+风格）映射进这五段。编译后的纯文本 prompt 仍必须含「主生成指令」和「禁止行为」。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "style_baseline",
    "opening_space",
    "underscore",
    "timed_action",
    "aftertaste",
    "txt_prompt_elements"
  ],
  "properties": {
    "schema": {"const": "video_kingdom.shot_prompt_template.v1"},
    "style_baseline": {
      "type": "string",
      "minLength": 1,
      "description": "风格基准：画幅、色调、画风、摄影质感。全剧锁定，单镜不得重写。必须匹配已签名 medium_lock.output_medium；非 UI_ANIMATION 不得写入微信/气泡/聊天界面。"
    },
    "style_lock": {"type": "string"},
    "subject_lock": {"type": "string"},
    "scene_lock": {"type": "string"},
    "count_constraints": {"type": "array"},
    "negative_constraints": {"type": "array", "items": {"type": "string"}},
    "opening_space": {
      "type": "string",
      "minLength": 1,
      "description": "起始空间：地点、主体、光线、镜头、首态。对应 TXT 的主体/环境/光线/镜头。"
    },
    "underscore": {
      "type": "string",
      "minLength": 1,
      "description": "底声：环境底噪、动作音、电话余音等；对白不写进画面文字。"
    },
    "timed_action": {
      "type": "string",
      "minLength": 1,
      "description": "分时序动作：0-1s 首态 → 唯一主要视觉事件 → 收势。内部切镜=0。"
    },
    "aftertaste": {
      "type": "string",
      "minLength": 1,
      "description": "余韵：末态停留、反应、留白；给下一镜提供末帧。"
    },
    "txt_prompt_elements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "action", "environment", "lighting", "camera", "style"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "camera": {"type": "string", "minLength": 1},
        "style": {"type": "string", "minLength": 1}
      }
    }
  }
}
