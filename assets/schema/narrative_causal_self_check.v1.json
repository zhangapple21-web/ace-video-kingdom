{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video_kingdom.narrative_causal_self_check.v1",
  "description": "叙事因果自检五问。TXT 未给出五问原文，本清单用王国 playbook 阶段0五问骨架 + TXT「3秒钩子、30秒转折、每集结尾强钩子」做成可填、可跑的检查。挂在现有 premise/causal_chain/plants/payoffs 之上，不另起根字段。",
  "type": "object",
  "required": ["schema", "rhythm_rule", "answers"],
  "properties": {
    "schema": {"const": "video_kingdom.narrative_causal_self_check.v1"},
    "rhythm_rule": {
      "type": "string",
      "const": "3秒钩子、30秒转折、每集结尾强钩子"
    },
    "answers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "question", "answer", "pass", "evidence"],
        "properties": {
          "id": {
            "enum": ["Q1_CAUSE", "Q2_INFO_PAYOFF", "Q3_HOOK_3S", "Q4_TURN_30S", "Q5_ENDING_HOOK"]
          },
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "pass": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
