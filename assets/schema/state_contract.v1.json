{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Kingdom State Contract v1",
  "type": "object",
  "required": ["schema", "identity_ref", "episode_state", "scene_state", "shot_state", "approved_for_next_shot"],
  "properties": {
    "schema": {"const": "video_kingdom.state_contract.v1"},
    "identity_ref": {"type": "string", "minLength": 1},
    "inherited_state_refs": {"type": "array", "items": {"type": "string"}},
    "episode_state": {"type": "object"},
    "scene_state": {
      "type": "object",
      "required": ["location", "time", "lighting", "space", "physical_layout", "interaction_surface", "scene_mode"],
      "properties": {
        "location": {"type": "string", "minLength": 1},
        "time": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "space": {"type": "string", "minLength": 1},
        "physical_layout": {"type": "string", "minLength": 1},
        "interaction_surface": {"type": "string", "minLength": 1},
        "scene_mode": {"const": "LIVE_DIEGETIC_SPACE"}
      }
    },
    "shot_state": {"type": "object"},
    "state_delta": {"type": "array"},
    "approved_for_next_shot": {"type": "boolean"},
    "source_refs": {"type": "array"}
  }
}
